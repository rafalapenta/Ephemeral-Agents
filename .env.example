ROUTER_PORT=8000
CHROMA_PORT=8001
LITELLM_PORT=4000
PAPERCLIP_PORT=3100
LOG_LEVEL=INFO

# ─── Security (Fases 0 & 1) ────────────────────────────────────────────────
# Every /api/* endpoint except /api/status requires X-Agentic-Token.
# If AGENCY_API_TOKEN is unset, the server generates a random token at startup
# and PRINTS it — that token changes on every restart, which forces you to
# re-paste it in the dashboard each time. Set a fixed value here to avoid that.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENCY_API_TOKEN=

# Concurrent agent executions allowed at once. /api/chat blocks a worker for up
# to 180s while a CLI subprocess runs; without this cap, ~40 concurrent
# requests saturate the AnyIO threadpool and the whole API stops responding.
# Default: 8
# AGENCY_MAX_CONCURRENT_RUNS=8

# HMAC-SHA256 secret for webhook signature verification (X-Signature +
# X-Agentic-Timestamp). Webhooks return 401 while this is unset and a
# signature is supplied. Default: empty (webhook verification disabled).
# Sign with:
#   hmac.new(secret, f"{timestamp}.".encode() + body, sha256).hexdigest()
# AGENCY_WEBHOOK_SECRET=

# Transition window for the webhook rollout: set to 1 for 7 days after
# deploying the signature check so existing emitters keep working, then remove
# it. Requests that DO send a signature must still verify correctly.
# Default: 0 (unsigned webhooks rejected)
# ALLOW_UNSIGNED_WEBHOOKS=0

# Lock-out escape hatch: set to 1 to disable authentication entirely. Requires
# host access to set, which is the same access needed to read this file. Use
# only to recover from a lost token — PUT /api/settings is itself token-gated.
# Default: 0
# AGENCY_RECOVERY_MODE=0

# ─── Rate limits (token bucket, per client) ────────────────────────────────
# Hardcoded in server.py (RATE_LIMITS); listed here for reference only.
#   default : 120 requests, refill 2.0/s
#   chat    :  10 requests, refill 0.2/s   (~1 request per 5s)
#   skill   :  20 requests, refill 0.5/s
#   admin   :  30 requests, refill 0.5/s   (backup, settings, plugins)
# Exceeding a tier returns 429 with Retry-After and X-RateLimit-* headers.

# Optional embedding/gateway providers. Do not commit real values.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
