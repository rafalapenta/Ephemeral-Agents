# ========================================
# AGency — Environment Variables Template
# Copy this file to .env and fill in real values
# DO NOT commit .env to version control
# ========================================

# --- AI Model Providers ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Model Selection ---
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=4096

# --- Database ---
DATABASE_URL=sqlite:///./agency_agents.db
# For production: postgresql://user:pass@localhost:5432/agency

# --- Vector Store (ChromaDB) ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=agency_roster

# --- MCP / FastMCP ---
MCP_SERVER_URL=http://localhost:8765
MCP_TIMEOUT_SECONDS=30

# --- Agent Routing ---
ROUTER_MODEL=openai
ROUTER_THRESHOLD=0.25
MAX_ROUTE_HOPS=3

# --- Scheduler ---
SCHEDULER_INTERVAL_SECONDS=300
HEARTBEAT_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/agency.log

# --- Skill Telemetry & Self-Improvement ---
SKILL_USAGE_RETENTION_DAYS=60
ROUTER_SUCCESS_WEIGHT=0.3
DISTILL_MIN_FAILURES=3

# --- LLM Gateway & Free-Tier Models ---
AGENCY_EMBEDDINGS=local
AGENCY_LLM_BASE_URL=http://localhost:20128/v1
AGENCY_LLM_API_KEY=
AGENCY_DEFAULT_MODEL=mistralai/mistral-7b-instruct:free
AGENCY_FALLBACK_MODEL=meta-llama/llama-3.2-3b-instruct:free
AGENCY_EPHEMERAL_MODEL=mistralai/mistral-7b-instruct:free
AGENCY_ALLOW_PAID=0

# --- Per-Director Model Overrides (Optional) ---
# AGENT_MODEL_VULCAN=qwen/qwen-2.5-coder-32b-instruct:free
# AGENT_FALLBACK_VULCAN=meta-llama/llama-3.2-3b-instruct:free
# AGENT_MODEL_VESPER=mistralai/mistral-7b-instruct:free
# AGENT_FALLBACK_VESPER=meta-llama/llama-3.2-3b-instruct:free
# AGENT_MODEL_STERLING=meta-llama/llama-3.2-3b-instruct:free
# AGENT_FALLBACK_STERLING=mistralai/mistral-7b-instruct:free
# AGENT_MODEL_LYRA=mistralai/mistral-7b-instruct:free
# AGENT_FALLBACK_LYRA=meta-llama/llama-3.2-3b-instruct:free
# AGENT_MODEL_AURA=mistralai/mistral-7b-instruct:free
# AGENT_FALLBACK_AURA=meta-llama/llama-3.2-3b-instruct:free
# AGENT_MODEL_ATLAS=mistralai/mistral-7b-instruct:free
# AGENT_FALLBACK_ATLAS=meta-llama/llama-3.2-3b-instruct:free

# --- Governance & Ephemeral Limits ---
EPHEMERAL_MAX_DEPTH=1
EPHEMERAL_MAX_PER_TASK=5
EPHEMERAL_MAX_TOOL_ITERATIONS=6
EPHEMERAL_MAX_TOKENS_PER_TASK=20000
EPHEMERAL_MAX_COST_USD_PER_TASK=0.00

# --- Dashboard ---
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

