# ========================================
# AGency — Environment Variables Template
# Copy this file to .env and fill in real values
# DO NOT commit .env to version control
# ========================================

# --- AI Model Providers ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Model Selection ---
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=4096

# --- Database ---
DATABASE_URL=sqlite:///./omniroute.db
# For production: postgresql://user:pass@localhost:5432/agency

# --- Vector Store (ChromaDB) ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=agency_roster

# --- MCP / FastMCP ---
MCP_SERVER_URL=http://localhost:8765
MCP_TIMEOUT_SECONDS=30

# --- Agent Routing ---
ROUTER_MODEL=openai
ROUTER_THRESHOLD=0.25
MAX_ROUTE_HOPS=3

# --- Scheduler ---
SCHEDULER_INTERVAL_SECONDS=300
HEARTBEAT_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/agency.log

# --- Skill Telemetry & Self-Improvement ---
SKILL_USAGE_RETENTION_DAYS=60
ROUTER_SUCCESS_WEIGHT=0.3
DISTILL_MIN_FAILURES=3

# --- LLM Gateway & Embeddings ---
AGENCY_EMBEDDINGS=local
AGENCY_LLM_BASE_URL=http://localhost:20128/v1
AGENCY_LLM_API_KEY=
AGENCY_EPHEMERAL_MODEL=mistral/ministral-8b-latest

# --- Dashboard ---
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

